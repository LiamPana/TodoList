# Copia questo file in ".env" e sostituisci i valori.
# Il file ".env" NON va committato (è nel .gitignore).

# --- Database (MySQL) ---
MYSQL_ROOT_PASSWORD=cambia-questa-root-password
MYSQL_DATABASE=todos
MYSQL_USER=app
MYSQL_PASSWORD=cambia-questa-password

# --- Applicazione ---
# Porta esposta sul computer / server
APP_PORT=5050
